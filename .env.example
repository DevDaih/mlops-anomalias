# Copie para .env (cp .env.example .env) e troque o valor. O .env NÃO vai para o git.
GF_SECURITY_ADMIN_PASSWORD=troque-esta-senha

# HF_TOKEN: só para publicar o modelo no Hugging Face (scripts/exportar_hf.py --push). No Codespaces vem do secret de usuário; não precisa estar no .env.
HF_TOKEN=cole-seu-token-aqui
